# Rendered by the nginx image's envsubst step (only ${ORTHANC_BASIC_B64} is substituted).

# Every /dicom-web/ request is checked by the API (session or share cookie + per-study access)
# through auth_request before it reaches Orthanc.

# ---------- App + API : port 80 ----------
server {
    listen 80;
    server_name _;
    client_max_body_size 0;

    root /usr/share/nginx/html;
    index index.html;

    location /api/internal/ { return 404; }

    location /api/ {
        proxy_pass http://api:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /_dicomweb_auth {
        internal;
        proxy_pass http://api:4000/api/internal/dicomweb-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header Cookie $http_cookie;
    }

    # Orthanc chooses the output format from the Accept header, and browsers send
    # image/avif,image/webp,... which it answers with 400. /rendered backs the
    # no-WebGL preview, so force a plain JPEG there.
    location ~ ^/dicom-web/.*/rendered$ {
        limit_except GET HEAD { deny all; }
        auth_request /_dicomweb_auth;
        proxy_pass http://orthanc:8042;
        proxy_set_header Host $http_host;
        proxy_set_header Accept "image/jpeg";
        proxy_set_header Authorization "Basic ${ORTHANC_BASIC_B64}";
    }

    location /dicom-web/ {
        limit_except GET HEAD { deny all; }
        auth_request /_dicomweb_auth;
        proxy_pass http://orthanc:8042/dicom-web/;
        # Orthanc builds absolute links (BulkData, studies) from the Host header:
        # without this, nginx sends "Host: orthanc:8042" and the viewer gets unreachable URLs.
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "Basic ${ORTHANC_BASIC_B64}";
        proxy_set_header Forwarded "proto=$scheme;host=$http_host";
        proxy_read_timeout 600s;
        proxy_buffering off;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /simple-viewer {
        add_header Cache-Control "no-store";
        try_files /simple-viewer.html =404;
    }

    location / {
        add_header Cache-Control "no-store";
        try_files $uri /index.html;
    }
}

# ---------- OHIF viewer : port 8081 ----------
server {
    listen 8081;
    server_name _;

    location = /_dicomweb_auth {
        internal;
        proxy_pass http://api:4000/api/internal/dicomweb-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header Cookie $http_cookie;
    }

    # Orthanc chooses the output format from the Accept header, and browsers send
    # image/avif,image/webp,... which it answers with 400. /rendered backs the
    # no-WebGL preview, so force a plain JPEG there.
    location ~ ^/dicom-web/.*/rendered$ {
        limit_except GET HEAD { deny all; }
        auth_request /_dicomweb_auth;
        proxy_pass http://orthanc:8042;
        proxy_set_header Host $http_host;
        proxy_set_header Accept "image/jpeg";
        proxy_set_header Authorization "Basic ${ORTHANC_BASIC_B64}";
    }

    location /dicom-web/ {
        limit_except GET HEAD { deny all; }
        auth_request /_dicomweb_auth;
        proxy_pass http://orthanc:8042/dicom-web/;
        # Orthanc builds absolute links (BulkData, studies) from the Host header:
        # without this, nginx sends "Host: orthanc:8042" and the viewer gets unreachable URLs.
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "Basic ${ORTHANC_BASIC_B64}";
        proxy_set_header Forwarded "proto=$scheme;host=$http_host";
        proxy_read_timeout 600s;
        proxy_buffering off;
    }

    # Fallback preview for clients without WebGL (server-side JPEG, no canvas)
    location = /simple-viewer {
        # this server has no root of its own, so state it here
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store";
        try_files /simple-viewer.html =404;
    }

    location / {
        proxy_pass http://ohif:80;
        proxy_set_header Host $http_host;
    }
}
